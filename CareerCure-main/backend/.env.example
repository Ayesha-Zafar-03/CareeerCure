# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://careercure:careercure@localhost:5432/careercure

# JWT — change this to a long random string in production
SECRET_KEY=your-super-secret-key-change-this

# Groq LLM — get your free key at https://console.groq.com
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Embedding model (downloaded automatically from HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# Frontend and backend URLs (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Google OAuth — https://console.developers.google.com/
