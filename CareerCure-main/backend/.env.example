# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://careercure:careercure@localhost:5432/careercure

# JWT — generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# Groq LLM — get your free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Embedding model (downloaded automatically from HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend and backend URLs (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Gmail SMTP (for OTP / password reset emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google OAuth — https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# External Job/Course APIs (optional)
RAPIDAPI_KEY=
LINKEDIN_JOBS_API_KEY=
INDEED_JOBS_API_KEY=
JSEARCH_API_KEY=
ADZUNA_API_ID=
ADZUNA_API_KEY=
