# Vercel Production – set these in Vercel Dashboard (Settings → Environment Variables)
# ── App ──
DEBUG=False

# ── Database (PostgreSQL) ──
# Use a hosted PostgreSQL provider: Supabase (free), Neon (free), Railway, Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ──
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── Groq LLM ──
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChromaDB (Vector DB) ──
# On Vercel serverless, the filesystem is ephemeral.
# Use CHROMA_SERVER_* for a hosted ChromaDB, or persist to /tmp (data lost on cold start)
CHROMA_PERSIST_DIR=/tmp/chroma_data

# ── Embeddings ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Gmail SMTP (for OTP emails) ──
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ── OAuth ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── External APIs ──
JSEARCH_API_KEY=
ADZUNA_API_ID=
ADZUNA_API_KEY=
RAPIDAPI_KEY=
LINKEDIN_JOBS_API_KEY=
INDEED_JOBS_API_KEY=
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

# ── URLs ──
FRONTEND_URL=https://careercure-frontend.vercel.app
BACKEND_URL=https://careercure-api.vercel.app
ALLOWED_ORIGINS=https://careercure-frontend.vercel.app,https://careercure-admin.vercel.app
